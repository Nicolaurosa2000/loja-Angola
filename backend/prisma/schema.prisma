generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique(map: "User_email_key")
  phone              String?
  password           String
  avatar             String?
  role               String               @default("CUSTOMER")
  isActive           Boolean              @default(true) @map("isactive")
  emailVerifiedAt    DateTime?            @map("emailverifiedat")
  resetToken         String?              @map("resettoken")
  resetTokenExp      DateTime?            @map("resettokenexp")
  createdAt          DateTime             @default(now()) @map("createdat")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updatedat")
  deletedAt          DateTime?            @map("deletedat")
  addresses          Address[]
  auditlog           AuditLog[]
  cart               Cart?
  couponusage        CouponUsage[]
  orders             Order[]
  reviews            ProductReview[]
  userroleassignment UserRoleAssignment[]
  wishlistitem       WishlistItem[]

  @@map("user")
}

model Role {
  id                 String               @id @default(uuid())
  name               String               @unique(map: "Role_name_key")
  description        String?
  createdAt          DateTime             @default(now()) @map("createdat")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updatedat")
  deletedAt          DateTime?            @map("deletedat")
  rolepermission     RolePermission[]
  userroleassignment UserRoleAssignment[]

  @@map("role")
}

model Permission {
  id             String           @id @default(uuid())
  name           String           @unique(map: "Permission_name_key")
  description    String?
  resource       String
  action         String
  createdAt      DateTime         @default(now()) @map("createdat")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updatedat")
  rolepermission RolePermission[]

  @@map("permission")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique(map: "Category_slug_key")
  description     String?
  image           String?
  metaTitle       String?    @map("metatitle")
  metaDescription String?    @map("metadescription")
  isActive        Boolean    @default(true) @map("isactive")
  sortOrder       Int        @default(0) @map("sortorder")
  parentId        String?    @map("parentid")
  createdAt       DateTime   @default(now()) @map("createdat")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updatedat")
  deletedAt       DateTime?  @map("deletedat")
  parent          Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryParent")
  products        Product[]

  @@index([parentId], map: "Category_parentId_idx")
  @@map("category")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique(map: "Brand_name_key")
  slug        String    @unique(map: "Brand_slug_key")
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true) @map("isactive")
  createdAt   DateTime  @default(now()) @map("createdat")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updatedat")
  deletedAt   DateTime? @map("deletedat")
  products    Product[]

  @@map("brand")
}

model Product {
  id                                                  String            @id @default(uuid())
  name                                                String
  slug                                                String            @unique(map: "Product_slug_key")
  description                                         String
  fullDescription                                     String?           @map("fulldescription")
  price                                               Float
  promotionalPrice                                    Float?            @map("promotionalprice")
  sku                                                 String            @unique(map: "Product_sku_key")
  code                                                String?
  weight                                              Float?
  length                                              Float?
  width                                               Float?
  height                                              Float?
  stock                                               Int               @default(0)
  minStock                                            Int               @default(0) @map("minstock")
  isFeatured                                          Boolean           @default(false) @map("isfeatured")
  isActive                                            Boolean           @default(true) @map("isactive")
  status                                              String            @default("ACTIVE")
  metaTitle                                           String?           @map("metatitle")
  metaDescription                                     String?           @map("metadescription")
  avgRating                                           Float?            @map("avgrating")
  videoUrl                                            String?           @map("videourl")
  categoryId                                          String?           @map("categoryid")
  brandId                                             String?           @map("brandid")
  createdAt                                           DateTime          @default(now()) @map("createdat")
  updatedAt                                           DateTime          @default(now()) @updatedAt @map("updatedat")
  deletedAt                                           DateTime?         @map("deletedat")
  cartItem                                            CartItem[]
  orderItem                                           OrderItem[]
  brand                                               Brand?            @relation(fields: [brandId], references: [id])
  category                                            Category?         @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  images                                              ProductImage[]
  productrelation_productrelation_productAIdToproduct ProductRelation[] @relation("productrelation_productAIdToproduct")
  productrelation_productrelation_productBIdToproduct ProductRelation[] @relation("productrelation_productBIdToproduct")
  reviews                                             ProductReview[]
  tags                                                ProductTag[]
  wishlistItem                                        WishlistItem[]

  @@index([brandId], map: "Product_brandId_idx")
  @@index([categoryId], map: "Product_categoryId_idx")
  @@index([sku], map: "Product_sku_idx")
  @@index([slug], map: "Product_slug_idx")
  @@map("product")
}

model Address {
  id           String    @id @default(uuid())
  label        String?
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  province     String
  zipCode      String?   @map("zipcode")
  isDefault    Boolean   @default(false) @map("isdefault")
  userId       String?   @map("userid")
  createdAt    DateTime  @default(now()) @map("createdat")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updatedat")
  deletedAt    DateTime? @map("deletedat")
  user         User?     @relation(fields: [userId], references: [id], onDelete: NoAction)
  order        Order[]

  @@index([userId], map: "Address_userId_idx")
  @@map("address")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String?  @map("resourceid")
  details    String?
  ip         String?
  userAgent  String?  @map("useragent")
  userId     String?  @map("userid")
  createdAt  DateTime @default(now()) @map("createdat")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action], map: "AuditLog_action_idx")
  @@index([resource, resourceId], map: "AuditLog_resource_resourceId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
  @@map("auditlog")
}

model Banner {
  id        String    @id @default(uuid())
  title     String?
  subtitle  String?
  image     String
  link      String?
  position  String    @default("HERO")
  sortOrder Int       @default(0) @map("sortorder")
  isActive  Boolean   @default(true) @map("isactive")
  createdAt DateTime  @default(now()) @map("createdat")
  updatedAt DateTime  @default(now()) @updatedAt @map("updatedat")
  deletedAt DateTime? @map("deletedat")

  @@map("banner")
}

model Cart {
  id        String     @id @default(uuid())
  sessionId String?    @unique @map("sessionid")
  userId    String?    @unique @map("userid")
  couponId  String?    @map("couponid")
  createdAt DateTime   @default(now()) @map("createdat")
  updatedAt DateTime   @default(now()) @updatedAt @map("updatedat")
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([couponId], map: "Cart_couponId_idx")
  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  cartId    String   @map("cartid")
  productId String   @map("productid")
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedat")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([cartId, productId]) // <-- Adicione esta linha
  @@index([productId], map: "CartItem_productId_idx")
  @@map("cartitem")
}

model Coupon {
  id             String          @id @default(uuid())
  code           String          @unique(map: "Coupon_code_key")
  description    String?
  type           String
  value          Float
  minOrderValue  Float?          @map("minordervalue")
  maxUses        Int?            @map("maxuses")
  usedCount      Int             @default(0) @map("usedcount")
  maxUsesPerUser Int?            @map("maxusesperuser")
  isActive       Boolean         @default(true) @map("isactive")
  startsAt       DateTime?       @map("startsat")
  expiresAt      DateTime?       @map("expiresat")
  createdAt      DateTime        @default(now()) @map("createdat")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updatedat")
  deletedAt      DateTime?       @map("deletedat")
  cart           Cart[]
  couponusage    CouponUsage[]
  orderdiscount  OrderDiscount[]

  @@map("coupon")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String   @map("couponid")
  userId    String   @map("userid")
  orderId   String?  @map("orderid")
  createdAt DateTime @default(now()) @map("createdat")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([couponId], map: "CouponUsage_couponId_idx")
  @@index([orderId], map: "CouponUsage_orderId_idx")
  @@index([userId], map: "CouponUsage_userId_idx")
  @@map("couponusage")
}

model NewsletterSubscriber {
  id         String    @id @default(uuid())
  email      String    @unique(map: "NewsletterSubscriber_email_key")
  name       String?
  isActive   Boolean   @default(true) @map("isactive")
  verifiedAt DateTime? @map("verifiedat")
  createdAt  DateTime  @default(now()) @map("createdat")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updatedat")
  deletedAt  DateTime? @map("deletedat")

  @@map("newslettersubscriber")
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String?              @map("ordernumber")
  userId         String?              @map("userid")
  addressId      String?              @map("addressid")
  status         String               @default("PENDING")
  subtotal       Float
  discountAmount Float                @default(0) @map("discountamount")
  shippingAmount Float                @default(0) @map("shippingamount")
  total          Float
  paymentMethod  String?              @map("paymentmethod")
  paymentStatus  String?              @map("paymentstatus")
  notes          String?
  trackingCode   String?              @map("trackingcode")
  paidAt         DateTime?            @map("paidat")
  cancelledAt    DateTime?            @map("cancelledat")
  deliveredAt    DateTime?            @map("deliveredat")
  createdAt      DateTime             @default(now()) @map("createdat")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updatedat")
  deletedAt      DateTime?            @map("deletedat")
  couponusage    CouponUsage[]
  address        Address?             @relation(fields: [addressId], references: [id])
  user           User?                @relation(fields: [userId], references: [id], onDelete: NoAction)
  discounts      OrderDiscount[]
  items          OrderItem[]
  payments       PaymentTransaction[]

  @@index([addressId], map: "Order_addressId_idx")
  @@index([orderNumber], map: "Order_orderNumber_idx")
  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_idx")
  @@map("order")
}

model OrderDiscount {
  id        String   @id @default(uuid())
  couponId  String   @map("couponid")
  orderId   String   @map("orderid")
  amount    Float
  createdAt DateTime @default(now()) @map("createdat")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@index([couponId], map: "OrderDiscount_couponId_idx")
  @@index([orderId], map: "OrderDiscount_orderId_idx")
  @@map("orderdiscount")
}

model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  unitPrice  Float    @default(0) @map("unitprice")
  totalPrice Float    @default(0) @map("totalprice")
  productId  String?  @map("productid")
  orderId    String?  @map("orderid")
  createdAt  DateTime @default(now()) @map("createdat")
  updatedAt  DateTime @default(now()) @updatedAt @map("updatedat")
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction)
  product    Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@map("orderitem")
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  orderId         String?   @map("orderid")
  method          String
  amount          Float
  status          String    @default("PENDING")
  transactionId   String?   @map("transactionid")
  gatewayResponse String?   @map("gatewayresponse")
  paidAt          DateTime? @map("paidat")
  createdAt       DateTime  @default(now()) @map("createdat")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updatedat")
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@index([orderId], map: "PaymentTransaction_orderId_idx")
  @@map("paymenttransaction")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sortorder")
  isCover   Boolean  @default(false) @map("iscover")
  productId String?  @map("productid")
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedat")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([productId], map: "ProductImage_productId_idx")
  @@map("productimage")
}

model ProductRelation {
  productAId                                  String   @map("productaid")
  productBId                                  String   @map("productbid")
  createdAt                                   DateTime @default(now()) @map("createdat")
  product_productrelation_productAIdToproduct Product  @relation("productrelation_productAIdToproduct", fields: [productAId], references: [id], onDelete: NoAction)
  product_productrelation_productBIdToproduct Product  @relation("productrelation_productBIdToproduct", fields: [productBId], references: [id], onDelete: NoAction)

  @@id([productAId, productBId])
  @@index([productBId], map: "ProductRelation_productBId_idx")
  @@map("productrelation")
}

model ProductReview {
  id        String    @id @default(uuid())
  rating    Int
  title     String?
  comment   String?
  status    String    @default("PENDING")
  userId    String    @map("userid")
  productId String    @map("productid")
  createdAt DateTime  @default(now()) @map("createdat")
  updatedAt DateTime  @default(now()) @updatedAt @map("updatedat")
  deletedAt DateTime? @map("deletedat")
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([productId], map: "ProductReview_productId_idx")
  @@map("productreview")
}

model ProductTag {
  id        String   @id @default(uuid())
  name      String
  productId String?  @map("productid")
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedat")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([productId], map: "ProductTag_productId_idx")
  @@map("producttag")
}

model RolePermission {
  roleId       String     @map("roleid")
  permissionId String     @map("permissionid")
  createdAt    DateTime   @default(now()) @map("createdat")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_idx")
  @@map("rolepermission")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique(map: "Setting_key_key")
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedat")

  @@map("setting")
}

model Upload {
  id           String   @id @default(uuid())
  filename     String
  originalName String   @default("") @map("originalname")
  mimeType     String   @default("application/octet-stream") @map("mimetype")
  size         Int
  path         String
  url          String
  createdAt    DateTime @default(now()) @map("createdat")
  updatedAt    DateTime @default(now()) @updatedAt @map("updatedat")

  @@map("upload")
}

model UserRoleAssignment {
  userId    String   @map("userid")
  roleId    String   @map("roleid")
  createdAt DateTime @default(now()) @map("createdat")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, roleId])
  @@index([roleId], map: "UserRoleAssignment_roleId_idx")
  @@map("userroleassignment")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("userid")
  productId String   @map("productid")
  createdAt DateTime @default(now()) @map("createdat")
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([productId], map: "WishlistItem_productId_idx")
  @@map("wishlistitem")
}