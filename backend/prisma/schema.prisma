generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id(map: "pk_user") @default(uuid()) @db.VarChar(191)
  name               String               @db.VarChar(191)
  email              String               @unique @db.VarChar(191)
  phone              String?              @db.VarChar(191)
  password           String               @db.VarChar(191)
  avatar             String?              @db.VarChar(191)
  role               String               @default("CUSTOMER") @db.VarChar(191)
  isActive           Boolean              @default(true) @map("isactive")
  emailVerifiedAt    DateTime?            @map("emailverifiedat")
  resetToken         String?              @map("resettoken") @db.VarChar(191)
  resetTokenExp      DateTime?            @map("resettokenexp")
  createdAt          DateTime             @default(now()) @map("createdat")
  updatedAt          DateTime             @updatedAt @map("updatedat")
  deletedAt          DateTime?            @map("deletedat")
  trial453           String?              @db.Char(1)
  addresses          Address[]
  auditlog           AuditLog[]
  cart               Cart?
  couponusage        CouponUsage[]
  orders             Order[]
  reviews            ProductReview[]
  userroleassignment UserRoleAssignment[]
  wishlistitem       WishlistItem[]

  @@map("user")
}

model Role {
  id                 String               @id(map: "pk_role") @default(uuid()) @db.VarChar(191)
  name               String               @unique @db.VarChar(191)
  description        String?              @db.VarChar(191)
  createdAt          DateTime             @default(now()) @map("createdat")
  updatedAt          DateTime             @updatedAt @map("updatedat")
  deletedAt          DateTime?            @map("deletedat")
  trial459           String?              @db.Char(1)
  rolepermission     RolePermission[]
  userroleassignment UserRoleAssignment[]

  @@map("role")
}

model Permission {
  id             String           @id(map: "pk_permission") @default(uuid()) @db.VarChar(191)
  name           String           @unique @db.VarChar(191)
  description    String?          @db.VarChar(191)
  resource       String           @db.VarChar(191)
  action         String           @db.VarChar(191)
  createdAt      DateTime         @default(now()) @map("createdat")
  updatedAt      DateTime         @updatedAt @map("updatedat")
  trial459       String?          @db.Char(1)
  rolepermission RolePermission[]

  @@map("permission")
}

model Category {
  id              String     @id(map: "pk_category") @default(uuid()) @db.VarChar(191)
  name            String     @db.VarChar(191)
  slug            String     @unique @db.VarChar(191)
  description     String?    @db.VarChar(191)
  image           String?    @db.VarChar(191)
  metaTitle       String?    @map("metatitle") @db.VarChar(191)
  metaDescription String?    @map("metadescription") @db.VarChar(191)
  isActive        Boolean    @default(true) @map("isactive")
  sortOrder       Int        @default(0) @map("sortorder")
  parentId        String?    @map("parentid") @db.VarChar(191)
  createdAt       DateTime   @default(now()) @map("createdat")
  updatedAt       DateTime   @updatedAt @map("updatedat")
  deletedAt       DateTime?  @map("deletedat")
  trial456        String?    @db.Char(1)
  parent          Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryParent")
  products        Product[]

  @@index([parentId])
  @@map("category")
}

model Brand {
  id          String    @id(map: "pk_brand") @default(uuid()) @db.VarChar(191)
  name        String    @unique @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.VarChar(191)
  logo        String?   @db.VarChar(191)
  website     String?   @db.VarChar(191)
  isActive    Boolean   @default(true) @map("isactive")
  createdAt   DateTime  @default(now()) @map("createdat")
  updatedAt   DateTime  @updatedAt @map("updatedat")
  deletedAt   DateTime? @map("deletedat")
  trial456    String?   @db.Char(1)
  products    Product[]

  @@map("brand")
}

model Product {
  id                                                  String            @id(map: "pk_product") @default(uuid()) @db.VarChar(191)
  name                                                String            @db.VarChar(191)
  slug                                                String            @unique @db.VarChar(191)
  description                                         String            @db.VarChar(191)
  fullDescription                                     String?           @map("fulldescription") @db.VarChar(191)
  price                                               Float
  promotionalPrice                                    Float?            @map("promotionalprice")
  sku                                                 String            @unique @db.VarChar(191)
  code                                                String?           @db.VarChar(191)
  weight                                              Float?
  length                                              Float?
  width                                               Float?
  height                                              Float?
  stock                                               Int               @default(0)
  minStock                                            Int               @default(0) @map("minstock")
  isFeatured                                          Boolean           @default(false) @map("isfeatured")
  isActive                                            Boolean           @default(true) @map("isactive")
  status                                              String            @default("ACTIVE") @db.VarChar(191)
  metaTitle                                           String?           @map("metatitle") @db.VarChar(191)
  metaDescription                                     String?           @map("metadescription") @db.VarChar(191)
  avgRating                                           Float?            @map("avgrating")
  videoUrl                                            String?           @map("videourl") @db.VarChar(191)
  categoryId                                          String?           @map("categoryid") @db.VarChar(191)
  brandId                                             String?           @map("brandid") @db.VarChar(191)
  createdAt                                           DateTime          @default(now()) @map("createdat")
  updatedAt                                           DateTime          @updatedAt @map("updatedat")
  deletedAt                                           DateTime?         @map("deletedat")
  trial456                                            String?           @db.Char(1)
  cartItem                                            CartItem[]
  orderItem                                           OrderItem[]
  brand                                               Brand?            @relation(fields: [brandId], references: [id])
  category                                            Category?         @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  images                                              ProductImage[]
  productrelation_productrelation_productAIdToproduct ProductRelation[] @relation("productrelation_productAIdToproduct")
  productrelation_productrelation_productBIdToproduct ProductRelation[] @relation("productrelation_productBIdToproduct")
  reviews                                             ProductReview[]
  tags                                                ProductTag[]
  wishlistItem                                        WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
  @@map("product")
}

model Address {
  id           String    @id(map: "pk_address") @default(uuid()) @db.VarChar(191)
  label        String?   @db.VarChar(191)
  street       String    @db.VarChar(191)
  number       String?   @db.VarChar(191)
  complement   String?   @db.VarChar(191)
  neighborhood String    @db.VarChar(191)
  city         String    @db.VarChar(191)
  province     String    @db.VarChar(191)
  zipCode      String?   @map("zipcode") @db.VarChar(191)
  isDefault    Boolean   @default(false) @map("isdefault")
  userId       String?   @map("userid") @db.VarChar(191)
  createdAt    DateTime  @default(now()) @map("createdat")
  updatedAt    DateTime  @updatedAt @map("updatedat")
  deletedAt    DateTime? @map("deletedat")
  trial453     String?   @db.Char(1)
  user         User?     @relation(fields: [userId], references: [id], onDelete: NoAction)
  order        Order[]

  @@map("address")
}

model AuditLog {
  id         String   @id(map: "pk_auditlog") @default(uuid()) @db.VarChar(191)
  action     String   @db.VarChar(191)
  resource   String   @db.VarChar(191)
  resourceId String?  @map("resourceid") @db.VarChar(191)
  details    String?  @db.VarChar(191)
  ip         String?  @db.VarChar(191)
  userAgent  String?  @map("useragent") @db.VarChar(191)
  userId     String?  @map("userid") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("createdat")
  trial453   String?  @db.Char(1)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([resource, resourceId])
  @@index([userId])
  @@map("auditlog")
}

model Banner {
  id        String    @id(map: "pk_banner") @default(uuid()) @db.VarChar(191)
  title     String?   @db.VarChar(191)
  subtitle  String?   @db.VarChar(191)
  image     String    @db.VarChar(191)
  link      String?   @db.VarChar(191)
  position  String    @default("HERO") @db.VarChar(191)
  sortOrder Int       @default(0) @map("sortorder")
  isActive  Boolean   @default(true) @map("isactive")
  createdAt DateTime  @default(now()) @map("createdat")
  updatedAt DateTime  @updatedAt @map("updatedat")
  deletedAt DateTime? @map("deletedat")
  trial456  String?   @db.Char(1)

  @@map("banner")
}

model Cart {
  id        String     @id(map: "pk_cart") @default(uuid()) @db.VarChar(191)
  sessionId String?    @unique @map("sessionid") @db.VarChar(191)
  userId    String?    @unique @map("userid") @db.VarChar(191)
  couponId  String?    @map("couponid") @db.VarChar(191)
  createdAt DateTime   @default(now()) @map("createdat")
  updatedAt DateTime   @updatedAt @map("updatedat")
  trial456  String?    @db.Char(1)
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@map("cart")
}

model CartItem {
  id        String   @id(map: "pk_cartitem") @default(uuid()) @db.VarChar(191)
  quantity  Int      @default(1)
  cartId    String   @map("cartid") @db.VarChar(191)
  productId String   @map("productid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")
  trial456  String?  @db.Char(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@map("cartitem")
}

model Coupon {
  id             String          @id(map: "pk_coupon") @default(uuid()) @db.VarChar(191)
  code           String          @unique @db.VarChar(191)
  description    String?         @db.VarChar(191)
  type           String          @db.VarChar(191)
  value          Float
  minOrderValue  Float?          @map("minordervalue")
  maxUses        Int?            @map("maxuses")
  usedCount      Int             @default(0) @map("usedcount")
  maxUsesPerUser Int?            @map("maxusesperuser")
  isActive       Boolean         @default(true) @map("isactive")
  startsAt       DateTime?       @map("startsat")
  expiresAt      DateTime?       @map("expiresat")
  createdAt      DateTime        @default(now()) @map("createdat")
  updatedAt      DateTime        @updatedAt @map("updatedat")
  deletedAt      DateTime?       @map("deletedat")
  trial456       String?         @db.Char(1)
  cart           Cart[]
  couponusage    CouponUsage[]
  orderdiscount  OrderDiscount[]

  @@map("coupon")
}

model CouponUsage {
  id        String   @id(map: "pk_couponusage") @default(uuid()) @db.VarChar(191)
  couponId  String   @map("couponid") @db.VarChar(191)
  userId    String   @map("userid") @db.VarChar(191)
  orderId   String?  @map("orderid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  trial456  String?  @db.Char(1)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@map("couponusage")
}

model NewsletterSubscriber {
  id         String    @id(map: "pk_newslettersubscriber") @default(uuid()) @db.VarChar(191)
  email      String    @unique @db.VarChar(191)
  name       String?   @db.VarChar(191)
  isActive   Boolean   @default(true) @map("isactive")
  verifiedAt DateTime? @map("verifiedat")
  createdAt  DateTime  @default(now()) @map("createdat")
  updatedAt  DateTime  @updatedAt @map("updatedat")
  deletedAt  DateTime? @map("deletedat")
  trial456   String?   @db.Char(1)

  @@map("newslettersubscriber")
}

model Order {
  id             String               @id(map: "pk_order") @default(uuid()) @db.VarChar(191)
  orderNumber    String?              @map("ordernumber") @db.VarChar(191)
  userId         String?              @map("userid") @db.VarChar(191)
  addressId      String?              @map("addressid") @db.VarChar(191)
  status         String               @default("PENDING") @db.VarChar(191)
  subtotal       Float
  discountAmount Float                @default(0) @map("discountamount")
  shippingAmount Float                @default(0) @map("shippingamount")
  total          Float
  paymentMethod  String?              @map("paymentmethod") @db.VarChar(191)
  paymentStatus  String?              @map("paymentstatus") @db.VarChar(191)
  notes          String?              @db.VarChar(191)
  trackingCode   String?              @map("trackingcode") @db.VarChar(191)
  paidAt         DateTime?            @map("paidat")
  cancelledAt    DateTime?            @map("cancelledat")
  deliveredAt    DateTime?            @map("deliveredat")
  createdAt      DateTime             @default(now()) @map("createdat")
  updatedAt      DateTime             @updatedAt @map("updatedat")
  deletedAt      DateTime?            @map("deletedat")
  trial456       String?              @db.Char(1)
  couponusage    CouponUsage[]
  address        Address?             @relation(fields: [addressId], references: [id])
  user           User?                @relation(fields: [userId], references: [id], onDelete: NoAction)
  discounts      OrderDiscount[]
  items          OrderItem[]
  payments       PaymentTransaction[]

  @@index([status])
  @@index([userId])
  @@map("order")
}

model OrderDiscount {
  id        String   @id(map: "pk_orderdiscount") @default(uuid()) @db.VarChar(191)
  couponId  String   @map("couponid") @db.VarChar(191)
  orderId   String   @map("orderid") @db.VarChar(191)
  amount    Float
  createdAt DateTime @default(now()) @map("createdat")
  trial456  String?  @db.Char(1)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@map("orderdiscount")
}

model OrderItem {
  id         String   @id(map: "pk_orderitem") @default(uuid()) @db.VarChar(191)
  quantity   Int
  unitPrice  Float    @map("unitprice")
  totalPrice Float    @map("totalprice")
  productId  String?  @map("productid") @db.VarChar(191)
  orderId    String?  @map("orderid") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("createdat")
  updatedAt  DateTime @updatedAt @map("updatedat")
  trial456   String?  @db.Char(1)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction)
  product    Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@map("orderitem")
}

model PaymentTransaction {
  id              String    @id(map: "pk_paymenttransaction") @default(uuid()) @db.VarChar(191)
  orderId         String?   @map("orderid") @db.VarChar(191)
  method          String    @db.VarChar(191)
  amount          Float
  status          String    @default("PENDING") @db.VarChar(191)
  transactionId   String?   @map("transactionid") @db.VarChar(191)
  gatewayResponse String?   @map("gatewayresponse") @db.Text
  paidAt          DateTime? @map("paidat")
  createdAt       DateTime  @default(now()) @map("createdat")
  updatedAt       DateTime  @updatedAt @map("updatedat")
  trial459        String?   @db.Char(1)
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@map("paymenttransaction")
}

model ProductImage {
  id        String   @id(map: "pk_productimage") @default(uuid()) @db.VarChar(191)
  url       String   @db.VarChar(191)
  alt       String?  @db.VarChar(191)
  sortOrder Int      @default(0) @map("sortorder")
  isCover   Boolean  @default(false) @map("iscover")
  productId String?  @map("productid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")
  trial459  String?  @db.Char(1)
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@map("productimage")
}

model ProductRelation {
  productAId                                  String   @map("productaid") @db.VarChar(191)
  productBId                                  String   @map("productbid") @db.VarChar(191)
  createdAt                                   DateTime @default(now()) @map("createdat")
  trial459                                    String?  @db.Char(1)
  product_productrelation_productAIdToproduct Product  @relation("productrelation_productAIdToproduct", fields: [productAId], references: [id], onDelete: NoAction)
  product_productrelation_productBIdToproduct Product  @relation("productrelation_productBIdToproduct", fields: [productBId], references: [id], onDelete: NoAction)

  @@id([productAId, productBId], map: "pk_productrelation")
  @@map("productrelation")
}

model ProductReview {
  id        String    @id(map: "pk_productreview") @default(uuid()) @db.VarChar(191)
  rating    Int
  title     String?   @db.VarChar(191)
  comment   String?   @db.VarChar(191)
  status    String    @default("PENDING") @db.VarChar(191)
  userId    String    @map("userid") @db.VarChar(191)
  productId String    @map("productid") @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("createdat")
  updatedAt DateTime  @updatedAt @map("updatedat")
  deletedAt DateTime? @map("deletedat")
  trial459  String?   @db.Char(1)
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@map("productreview")
}

model ProductTag {
  id        String   @id(map: "pk_producttag") @default(uuid()) @db.VarChar(191)
  name      String   @db.VarChar(191)
  productId String?  @map("productid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedat")
  trial459  String?  @db.Char(1)
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@map("producttag")
}

model RolePermission {
  roleId       String     @map("roleid") @db.VarChar(191)
  permissionId String     @map("permissionid") @db.VarChar(191)
  createdAt    DateTime   @default(now()) @map("createdat")
  trial459     String?    @db.Char(1)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@id([roleId, permissionId], map: "pk_rolepermission")
  @@map("rolepermission")
}

model Setting {
  id        String   @id(map: "pk_setting") @default(uuid()) @db.VarChar(191)
  key       String   @unique @db.VarChar(191)
  value     String   @db.VarChar(191)
  group     String   @default("general") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")
  trial459  String?  @db.Char(1)

  @@map("setting")
}

model Upload {
  id           String   @id(map: "pk_upload") @default(uuid()) @db.VarChar(191)
  filename     String   @db.VarChar(191)
  originalName String   @map("originalname") @db.VarChar(191)
  mimeType     String   @map("mimetype") @db.VarChar(191)
  size         Int
  path         String   @db.VarChar(191)
  url          String   @db.VarChar(191)
  createdAt    DateTime @default(now()) @map("createdat")
  updatedAt    DateTime @updatedAt @map("updatedat")
  trial459     String?  @db.Char(1)

  @@map("upload")
}

model UserRoleAssignment {
  userId    String   @map("userid") @db.VarChar(191)
  roleId    String   @map("roleid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  trial459  String?  @db.Char(1)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, roleId], map: "pk_userroleassignment")
  @@map("userroleassignment")
}

model WishlistItem {
  id        String   @id(map: "pk_wishlistitem") @default(uuid()) @db.VarChar(191)
  userId    String   @map("userid") @db.VarChar(191)
  productId String   @map("productid") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("createdat")
  trial459  String?  @db.Char(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@map("wishlistitem")
}