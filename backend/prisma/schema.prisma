generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique(map: "User_email_key")
  phone              String?
  password           String
  avatar             String?
  role               String               @default("CUSTOMER")
  isActive           Boolean              @default(true)
  emailVerifiedAt    DateTime?
  resetToken         String?
  resetTokenExp      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  addresses          Address[]
  auditlog           AuditLog[]
  cart               Cart?
  couponusage        CouponUsage[]
  orders             Order[]
  reviews            ProductReview[]
  userroleassignment UserRoleAssignment[]
  wishlistitem       WishlistItem[]

  @@map("user")
}

model Role {
  id                 String               @id @default(uuid())
  name               String               @unique(map: "Role_name_key")
  description        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  rolepermission     RolePermission[]
  userroleassignment UserRoleAssignment[]

  @@map("role")
}

model Permission {
  id             String           @id @default(uuid())
  name           String           @unique(map: "Permission_name_key")
  description    String?
  resource       String
  action         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rolepermission RolePermission[]

  @@map("permission")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique(map: "Category_slug_key")
  description     String?
  image           String?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  parentId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  parent          Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryParent")
  products        Product[]

  @@index([parentId], map: "Category_parentId_idx")
  @@map("category")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique(map: "Brand_name_key")
  slug        String    @unique(map: "Brand_slug_key")
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]

  @@map("brand")
}

model Product {
  id                                                  String            @id @default(uuid())
  name                                                String
  slug                                                String            @unique(map: "Product_slug_key")
  description                                         String
  fullDescription                                     String?
  price                                               Float
  promotionalPrice                                    Float?
  sku                                                 String            @unique(map: "Product_sku_key")
  code                                                String?
  weight                                              Float?
  length                                              Float?
  width                                               Float?
  height                                              Float?
  stock                                               Int               @default(0)
  minStock                                            Int               @default(0)
  isFeatured                                          Boolean           @default(false)
  isActive                                            Boolean           @default(true)
  status                                              String            @default("ACTIVE")
  metaTitle                                           String?
  metaDescription                                     String?
  avgRating                                           Float?
  videoUrl                                            String?
  categoryId                                          String
  brandId                                             String?
  createdAt                                           DateTime          @default(now())
  updatedAt                                           DateTime          @updatedAt
  deletedAt                                           DateTime?
  cartItem                                            CartItem[]
  orderItem                                           OrderItem[]
  brand                                               Brand?            @relation(fields: [brandId], references: [id])
  category                                            Category          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  images                                              ProductImage[]
  productrelation_productrelation_productAIdToproduct ProductRelation[] @relation("productrelation_productAIdToproduct")
  productrelation_productrelation_productBIdToproduct ProductRelation[] @relation("productrelation_productBIdToproduct")
  reviews                                             ProductReview[]
  tags                                                ProductTag[]
  wishlistItem                                        WishlistItem[]

  @@index([brandId], map: "Product_brandId_idx")
  @@index([categoryId], map: "Product_categoryId_idx")
  @@index([sku], map: "Product_sku_idx")
  @@index([slug], map: "Product_slug_idx")
  @@map("product")
}

model Address {
  id           String    @id @default(uuid())
  label        String?
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  province     String
  zipCode      String?
  isDefault    Boolean   @default(false)
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction)
  order        Order[]

  @@index([userId], map: "Address_userId_idx")
  @@map("address")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String?
  details    String?
  ip         String?
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action], map: "AuditLog_action_idx")
  @@index([resource, resourceId], map: "AuditLog_resource_resourceId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
  @@map("auditlog")
}

model Banner {
  id        String    @id @default(uuid())
  title     String?
  subtitle  String?
  image     String
  link      String?
  position  String    @default("HERO")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("banner")
}

model Cart {
  id        String     @id @default(uuid())
  sessionId String?    @unique(map: "Cart_sessionId_key")
  userId    String?    @unique(map: "Cart_userId_key")
  couponId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([couponId], map: "Cart_couponId_idx")
  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  cartId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([cartId, productId], map: "CartItem_cartId_productId_key")
  @@index([productId], map: "CartItem_productId_idx")
  @@map("cartitem")
}

model Coupon {
  id             String          @id @default(uuid())
  code           String          @unique(map: "Coupon_code_key")
  description    String?
  type           String
  value          Float
  minOrderValue  Float?
  maxUses        Int?
  usedCount      Int             @default(0)
  maxUsesPerUser Int?
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  cart           Cart[]
  couponusage    CouponUsage[]
  orderdiscount  OrderDiscount[]

  @@map("coupon")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String?
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([couponId], map: "CouponUsage_couponId_idx")
  @@index([orderId], map: "CouponUsage_orderId_idx")
  @@index([userId], map: "CouponUsage_userId_idx")
  @@map("couponusage")
}

model NewsletterSubscriber {
  id         String    @id @default(uuid())
  email      String    @unique(map: "NewsletterSubscriber_email_key")
  name       String?
  isActive   Boolean   @default(true)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("newslettersubscriber")
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String               @unique(map: "Order_orderNumber_key")
  userId         String
  addressId      String?
  status         String               @default("PENDING")
  subtotal       Float
  discountAmount Float                @default(0)
  shippingAmount Float                @default(0)
  total          Float
  paymentMethod  String?
  paymentStatus  String?
  notes          String?
  trackingCode   String?
  paidAt         DateTime?
  cancelledAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  couponusage    CouponUsage[]
  address        Address?             @relation(fields: [addressId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: NoAction)
  discounts      OrderDiscount[]
  items          OrderItem[]
  payments       PaymentTransaction[]

  @@index([addressId], map: "Order_addressId_idx")
  @@index([orderNumber], map: "Order_orderNumber_idx")
  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_idx")
  @@map("order")
}

model OrderDiscount {
  id        String   @id @default(uuid())
  couponId  String
  orderId   String
  amount    Float
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@index([couponId], map: "OrderDiscount_couponId_idx")
  @@index([orderId], map: "OrderDiscount_orderId_idx")
  @@map("orderdiscount")
}

model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  unitPrice  Float
  totalPrice Float
  productId  String
  orderId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@map("orderitem")
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  orderId         String
  method          String
  amount          Float
  status          String    @default("PENDING")
  transactionId   String?   @unique(map: "PaymentTransaction_transactionId_key")
  gatewayResponse String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@index([orderId], map: "PaymentTransaction_orderId_idx")
  @@map("paymenttransaction")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([productId], map: "ProductImage_productId_idx")
  @@map("productimage")
}

model ProductRelation {
  productAId                                  String
  productBId                                  String
  createdAt                                   DateTime @default(now())
  product_productrelation_productAIdToproduct Product  @relation("productrelation_productAIdToproduct", fields: [productAId], references: [id], onDelete: NoAction)
  product_productrelation_productBIdToproduct Product  @relation("productrelation_productBIdToproduct", fields: [productBId], references: [id], onDelete: NoAction)

  @@id([productAId, productBId])
  @@index([productBId], map: "ProductRelation_productBId_idx")
  @@map("productrelation")
}

model ProductReview {
  id        String    @id @default(uuid())
  rating    Int
  title     String?
  comment   String?
  status    String    @default("PENDING")
  userId    String
  productId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([userId, productId], map: "ProductReview_userId_productId_key")
  @@index([productId], map: "ProductReview_productId_idx")
  @@map("productreview")
}

model ProductTag {
  id        String   @id @default(uuid())
  name      String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([name, productId], map: "ProductTag_name_productId_key")
  @@index([productId], map: "ProductTag_productId_idx")
  @@map("producttag")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_idx")
  @@map("rolepermission")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique(map: "Setting_key_key")
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setting")
}

model Upload {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("upload")
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, roleId])
  @@index([roleId], map: "UserRoleAssignment_roleId_idx")
  @@map("userroleassignment")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([userId, productId], map: "WishlistItem_userId_productId_key")
  @@index([productId], map: "WishlistItem_productId_idx")
  @@map("wishlistitem")
}