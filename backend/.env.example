# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database (Supabase PostgreSQL)
# Pooler URL para o runtime da aplicação
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct URL - usa o pooler quando a ligação direta não está disponível
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT - gere secrets longas e únicas em produção
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (Storage)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<your-supabase-key>

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Encryption
BCRYPT_SALT_ROUNDS=12

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=30
